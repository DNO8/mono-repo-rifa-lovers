# ==========================================
# DATABASE
# ==========================================
DATABASE_URL=""

# ==========================================
# SUPABASE AUTH (REQUERIDO)
# ==========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:3000

# ==========================================
# FLOW PAYMENTS
# ==========================================
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_BASE_URL=https://sandbox.flow.cl/api

# ==========================================
# RESEND EMAIL SERVICE (NUEVO - Reemplaza SMTP)
# ==========================================
# Obtener API key en: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Emails de dominio propio (configurar en Resend Dashboard)
EMAIL_FROM_NOREPLY=noreply@rifalovers.cl
EMAIL_FROM_CONTACT=contacto@rifalovers.cl
EMAIL_TO_CONTACT=contacto@rifalovers.cl

# ==========================================
# LEGACY SMTP (DEPRECATED - Solo compatibilidad temporal)
# ==========================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@rifalovers.com
